{
  "$schema_note": "Declarative Cloud SQL PostgreSQL 17 security policy for company databases.",
  "databaseVersion": "POSTGRES_17",
  "ipConfiguration": {
    "ipv4Enabled": false,
    "requireSsl": true,
    "sslMode": "ENCRYPTED_ONLY",
    "authorizedNetworks": []
  },
  "connectionProtocol": {
    "connector": "cloud-sql-connector",
    "dedicatedServiceAccount": true,
    "passwordAuthAllowed": false
  },
  "databaseFlags": {
    "cloudsql.iam_authentication": "on",
    "cloudsql.enable_pgaudit": "on",
    "pgaudit.log": "all",
    "pgaudit.log_parameter": "off",
    "log_connections": "on",
    "log_disconnections": "on",
    "log_parameter_max_length": "0",
    "log_parameter_max_length_on_error": "0",
    "log_statement": "none"
  },
  "roles": {
    "platform_app": {
      "businessTables": [],
      "appViews": ["SELECT"],
      "appCmd": ["EXECUTE"]
    },
    "platform_worker": {
      "businessTables": ["SELECT"],
      "appCmd": ["EXECUTE"]
    },
    "platform_writer": {
      "businessTables": ["SELECT", "INSERT"],
      "reviewSubmissions": ["SELECT", "INSERT", "UPDATE"],
      "reviewDrafts": ["SELECT", "INSERT", "UPDATE", "DELETE"],
      "auditJournal": ["SELECT", "INSERT"]
    },
    "platform_readonly": {
      "businessTables": ["SELECT"],
      "appViews": ["SELECT"]
    },
    "platform_view_owner": {
      "businessTables": ["SELECT"],
      "securityBarrierViews": true
    },
    "platform_versioner": {
      "versionedSupersession": true,
      "fkBackfill": true
    },
    "platform_iam_sync": {
      "iamTables": ["SELECT", "INSERT"],
      "agentAffiliations": ["SELECT"],
      "roleGrantPeople": ["SELECT"],
      "personAuthIdentities": [],
      "signingKeys": ["SELECT", "INSERT", "UPDATE"],
      "signingKeyScopes": ["nusear_staff", "service"],
      "auditJournal": ["SELECT", "INSERT"]
    },
    "platform_migrator": {
      "migrations": true
    },
    "platform_auth_lookup": {
      "authLookup": ["EXECUTE"]
    }
  }
}
